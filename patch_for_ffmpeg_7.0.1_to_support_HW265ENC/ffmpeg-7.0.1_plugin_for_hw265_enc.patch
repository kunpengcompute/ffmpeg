+                                                       m_ptemp,
+                                                       m_mtemp,
+                                                       m_atemp,
+                                                       m_btemp,
+                                                       m_ntemp,
+                                                       K1temp,
+                                                       K2temp,
+                                                       K3temp,
+                                                       2,
+                                                       P3Spline_TH_MB,
+                                                       P3Spline_TH,
+                                                       StrengthDelta,
+                                                       MaxDisplaytemp,
+                                                       &md1,
+                                                       &mc1,
+                                                       &mb1,
+                                                       &ma1,
+                                                       &md2,
