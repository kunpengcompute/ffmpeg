+static void writeOut(HDRVividBitStream *bitstream, unsigned char val) {
+    if (bitstream->fifo != NULL) {
+        if (bitstream->byteOccupancy >= bitstream->byteAlloc) {
+            unsigned char *temp = (unsigned char *) malloc(sizeof(unsigned char) * bitstream->byteAlloc * 2);
+            if (temp) {
+                memcpy(temp, bitstream->fifo, bitstream->byteOccupancy);
+                free(bitstream->fifo);
+                bitstream->fifo = temp;
+                bitstream->byteAlloc *= 2;
+            } else {
+                return;
+            }
+        }
+        bitstream->fifo[bitstream->byteOccupancy++] = val;
+    }
+}
+
+static void write(HDRVividBitStream *bitstream, unsigned int val, unsigned int numBits) {
+    unsigned int totalPartialBits = bitstream->partialByteBits + numBits;
+    unsigned int nextPartialBits = totalPartialBits & 7;
+    unsigned char nextHeldByte = val << (8 - nextPartialBits);
+    unsigned int writeBytes = totalPartialBits >> 3;
+
+    if (writeBytes) {
+        unsigned int topword = (numBits - nextPartialBits) & ~7;
+        unsigned int write_bits = (topword < 32 ? bitstream->partialByte << topword : 0) | (val >> nextPartialBits);
+        switch (writeBytes) {
+            case 4:
+                writeOut(bitstream, (write_bits >> 24));
+            case 3:
+                writeOut(bitstream, (write_bits >> 16));
+            case 2:
+                writeOut(bitstream, (write_bits >> 8));
+            case 1:
+                writeOut(bitstream, (write_bits));
+        }
+        bitstream->partialByte = nextHeldByte;
+        bitstream->partialByteBits = nextPartialBits;
+    } else {
+        bitstream->partialByte |= nextHeldByte;
+        bitstream->partialByteBits = nextPartialBits;
+    }
+}
+
+static void writeAlignZero(HDRVividBitStream *bitstream) {
+    if (bitstream->partialByteBits) {
+        writeOut(bitstream, bitstream->partialByte);
+        bitstream->partialByte = 0;
+        bitstream->partialByteBits = 0;
+    }
+}
