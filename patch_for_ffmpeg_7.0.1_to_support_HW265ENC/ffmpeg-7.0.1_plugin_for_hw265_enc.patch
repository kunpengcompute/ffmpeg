+    GetYUVBuffer(&metedataBuf->FixedFile444P, metedataBuf->width, metedataBuf->height, Fixed, YUV444);
+    GetYUVBuffer(&metedataBuf->FloatFile444P, metedataBuf->width, metedataBuf->height, Float, YUV444);
+    GetYUVBuffer(&metedataBuf->FloatFile420P, metedataBuf->width, metedataBuf->height, Float, YUV420);
+    metedataBuf->Fixed32Data = (long *) malloc(
+            sizeof(long) * (metedataBuf->width) * (metedataBuf->height) * 2);
+    metedataBuf->HDRVividBitStream1.fifo = (uint8_t *) malloc(sizeof(uint8_t) * MIN_FIFO_SIZE);
+    metedataBuf->last_floatComp = (float*)malloc(metedataBuf->width * metedataBuf->height * 4 * sizeof(float));    
+}
+
+void ReleaseBuffer(GenerateMetadataBuffer *metedataBuf) {
+    ReleaseYUVBuffer(&metedataBuf->FixedFile444P);
+    ReleaseYUVBuffer(&metedataBuf->FloatFile444P);
+    ReleaseYUVBuffer(&metedataBuf->FloatFile420P);
+    if (metedataBuf->Fixed32Data != NULL) {
+        free(metedataBuf->Fixed32Data);
+        metedataBuf->Fixed32Data = NULL;
+    }
+    if (metedataBuf->HDRVividBitStream1.fifo != NULL) {
