+static double
+GetDeltaMp(double temp, double mP, double minDeltaMp, double maxDeltaMp, double lumaMaxdisplay, double lumaTarget) {
+    if (temp < 3.0) {
+        temp = 3.0;
+    }
+    double deltamp = (mP - temp);
+    double ratio;
+    ratio = (lumaTarget - lumaMaxdisplay) / 100.0;
+    if (ratio < 0) {
+        ratio = 0.0;
+    }
+    ratio = pow(ratio, 0.5);
+    if (!feq(ratio,0)) {
+        ratio = 1.0 / ratio;
+    } else {
+        ratio = 0.1;
+    }
+    deltamp *= ratio;
+    deltamp = deltamp < minDeltaMp ? minDeltaMp : (deltamp > maxDeltaMp ? maxDeltaMp : deltamp);
+    return deltamp;
+}
