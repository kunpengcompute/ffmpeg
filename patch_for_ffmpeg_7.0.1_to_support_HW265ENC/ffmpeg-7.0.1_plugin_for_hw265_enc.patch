+    if (Metadata->tone_mapping_mode) {
+        write(BitStream, Metadata->tone_mapping_param_num - 1, tone_mapping_param_num_BIT);
+        for (unsigned int i = 0; i <= Metadata->tone_mapping_param_num - 1; i++) {
+            write(BitStream, Metadata->targeted_system_display_maximum_luminance[i], targeted_system_display_BIT);
+            write(BitStream, Metadata->Base_flag[i], Base_flag_BIT);
+            if (Metadata->Base_flag[i]) {
+                write(BitStream, Metadata->Base_param_m_p[i], Base_param_m_p_BIT);
+                write(BitStream, Metadata->Base_param_m_m[i], Base_param_m_m_BIT);
+                write(BitStream, Metadata->Base_param_m_a[i], Base_param_m_a_BIT);
+                write(BitStream, Metadata->Base_param_m_b[i], Base_param_m_b_BIT);
+                write(BitStream, Metadata->Base_param_m_n[i], Base_param_m_n_BIT);
+                write(BitStream, Metadata->Base_param_K1[i], Base_param_K1_BIT);
+                write(BitStream, Metadata->Base_param_K2[i], Base_param_K2_BIT);
+                write(BitStream, Metadata->Base_param_K3[i], Base_param_K3_BIT);
+                write(BitStream, Metadata->base_param_Delta_mode[i], Base_param_Delta_mode_BIT);
+                write(BitStream, Metadata->base_param_Delta[i], Base_param_Delta_BIT);
+            }
+
+            write(BitStream, Metadata->P3Spline_flag[i], P3Spline_flag_BIT);
+            if (Metadata->P3Spline_flag[i]) {
+                write(BitStream, Metadata->P3Spline_num[i] - 1, P3Spline_num_BIT);
+                for (unsigned int mode_i = 0; mode_i <= Metadata->P3Spline_num[i] - 1; mode_i++) {
+                    write(BitStream, Metadata->P3Spline_TH_mode[i][mode_i], P3Spline_TH_mode_BIT);
+                    if ((Metadata->P3Spline_TH_mode[i][mode_i] == 0) || (Metadata->P3Spline_TH_mode[i][mode_i] == 2)) {
+                        write(BitStream, Metadata->P3Spline_TH_MB[i][mode_i], P3Spline_TH_MB_BIT);
+                    }
+                    write(BitStream, Metadata->P3Spline_TH[i][mode_i][0], P3Spline_TH1_BIT);
+                    write(BitStream, Metadata->P3Spline_TH[i][mode_i][1], P3Spline_TH2_BIT);
+                    write(BitStream, Metadata->P3Spline_TH[i][mode_i][2], P3Spline_TH3_BIT);
+                    write(BitStream, Metadata->P3Spline_Strength[i][mode_i], P3Spline_Strength_BIT);
+                }
+            }
+        }
+    }
+    write(BitStream, Metadata->color_saturation_mapping_flag, color_saturation_BIT);
+    if (Metadata->color_saturation_mapping_flag) {
+        write(BitStream, Metadata->color_saturation_num, color_saturation_num_BIT);
+        for (unsigned int mode_i = 0; mode_i < Metadata->color_saturation_num; mode_i++) {
+            write(BitStream, Metadata->color_saturation_gain[mode_i], color_saturation_gain_BIT);
+        }
+    }
+    writeAlignZero(BitStream);
+    (*payloadSize) = BitStream->byteOccupancy + 5;
+    (*payload) = (unsigned char *) malloc(sizeof(unsigned char) * (*payloadSize));
+    (*payload)[0] = countryCode;
+    (*payload)[1] = (unsigned char) ((terminalProviderCode >> 8) & 0xFF);
+    (*payload)[2] = (unsigned char) (terminalProviderCode & 0xFF);
+    (*payload)[3] = (unsigned char) ((terminalProviderOrientedCode >> 8) & 0xFF);
+    (*payload)[4] = (unsigned char) (terminalProviderOrientedCode & 0xFF);
+    memcpy(&(*payload)[5], BitStream->fifo, BitStream->byteOccupancy);
+}
+
+//-----------------------------------------------------------------------------
+// Public methods
+//-----------------------------------------------------------------------------
+#include <stdio.h>
+static void process(GenerateMetadataBuffer *metedataBuf, float *RGB[3], int width, int height, char *fileName,
+                    double targetedDisplay) {
+    HDRVividMetadata metadata;
+    int isScreenChange = 0;
+    metedataBuf->FrameNum++;
+    getMetedata(metedataBuf, RGB, width, height, (feq(metedataBuf->FrameNum, 1) ? 1 : 0), &metadata,
+                &metedataBuf->m_window_size, &metedataBuf->m_sample_size, &metedataBuf->m_filter_type, &isScreenChange,
+                targetedDisplay);
+    memcpy((unsigned char *) (&metedataBuf->m_metadata), (unsigned char *) (&metadata), sizeof(HDRVividMetadata));
+}
+
+static void YUV420to444(GenerateMetadataBuffer *metedataBuf, const YUVPicBuffer *In, YUVPicBuffer *out) {
+    long Fixed32Filter[4][4];
+    Fixed32Filter[0][0] = (long) fRound(-8.0);
+    Fixed32Filter[0][1] = (long) fRound(64.0);
+    Fixed32Filter[0][2] = (long) fRound(216.0);
+    Fixed32Filter[0][3] = (long) fRound(-16.0);
+    Fixed32Filter[1][0] = (long) fRound(-16.0);
+    Fixed32Filter[1][1] = (long) fRound(216.0);
+    Fixed32Filter[1][2] = (long) fRound(64.0);
+    Fixed32Filter[1][3] = (long) fRound(-8.0);
+    Fixed32Filter[2][0] = (long) fRound(0.0);
+    Fixed32Filter[2][1] = (long) fRound(256.0);
+    Fixed32Filter[3][0] = (long) fRound(-10.0);
+    Fixed32Filter[3][1] = (long) fRound(138.0);
+    Fixed32Filter[3][2] = (long) fRound(138.0);
+    Fixed32Filter[3][3] = (long) fRound(-10.0);
+
+    memcpy(out->FixedChannel[0], In->FixedChannel[0], (int) (out->channel_num[0]) * sizeof(uint8));
+    for (int k = 1; k <= 2; k++) {
+        uint8 *outFile = out->FixedChannel[k];
+        uint8 *inpFile = In->FixedChannel[k];
+        for (int j = 0; j < (out->pic_height[k]) / 2; j++) {
+            for (int i = 0; i < (out->pic_width[k]) / 2; i++) {
+                {
+                    int m;
+                    int value = 0;
+                    for (m = 0; m < 4; m++) {
+                        value += Fixed32Filter[0][m] * inpFile[i + iClip(j + m - 2, 0, (out->pic_height[k]) / 2 - 1) *
+                                                                   ((out->pic_width[k]) / 2)];
+                    }
+                    metedataBuf->Fixed32Data[(2 * j) * ((out->pic_width[k]) / 2) + i] = (value + 0) >> 0;
+                }
+                {
+                    int m;
+                    int value = 0;
+                    for (m = 0; m < 4; m++) {
+                        value += Fixed32Filter[1][m] * inpFile[i +
+                                                               iClip(j + 1 + m - 2, 0, (out->pic_height[k]) / 2 - 1) *
+                                                               ((out->pic_width[k]) / 2)];
+                    }
+                    metedataBuf->Fixed32Data[(2 * j + 1) * ((out->pic_width[k]) / 2) + i] = (value + 0) >> 0;
+                }
+            }
+        }
+        for (int j = 0; j < out->pic_height[k]; j++) {
+            for (int i = 0; i < (out->pic_width[k]) / 2; i++) {
+                {
+                    int m;
+                    int value = 0;
+                    for (m = 0; m < 2; m++) {
+                        value += Fixed32Filter[2][m] * metedataBuf->Fixed32Data[j * ((out->pic_width[k]) / 2) +
+                                                                                iClip(i + m - 1, 0,
+                                                                                      ((out->pic_width[k]) / 2) - 1)];
+                    }
+                    outFile[j * (out->pic_width[k]) + 2 * i] = (value + 32768) >> 16;
+                }
+                {
+                    int m;
+                    int value = 0;
+                    for (m = 0; m < 4; m++) {
+                        value += Fixed32Filter[3][m] * metedataBuf->Fixed32Data[j * ((out->pic_width[k]) / 2) +
+                                                                                iClip(i + 1 + m - 2, 0,
+                                                                                      ((out->pic_width[k]) / 2) - 1)];
+                    }
+                    outFile[j * (out->pic_width[k]) + 2 * i + 1] = (value + 32768) >> 16;
+                }
+            }
+        }
+    }
+}
+
+static void FixedtoFloat(const YUVPicBuffer *In, YUVPicBuffer *out) {
+    double weight = 1.0 / 876;
+    for (int i = 0; i < In->channel_num[0]; i++) {
+        out->FloatChannel[0][i] = fClip((float) ((weight * (double) (In->FixedChannel[0][i] - 64))), 0.0f, 1.0f);
+    }
+    weight = 1.0 / 896;
+    for (int i = 0; i < In->channel_num[1]; i++) {
+        out->FloatChannel[1][i] = fClip((float) ((weight * (double) (In->FixedChannel[1][i] - 512))), -0.5f, 0.5f);
+    }
+    for (int i = 0; i < In->channel_num[2]; i++) {
+        out->FloatChannel[2][i] = fClip((float) ((weight * (double) (In->FixedChannel[2][i] - 512))), -0.5f, 0.5f);
+    }
+}
+
+static void YUVtoRGB(YUVPicBuffer *In) {
+    for (int i = 0; i < In->channel_num[0]; i++) {
+        double comp0 = In->FloatChannel[0][i];
+        double comp1 = In->FloatChannel[1][i];
+        double comp2 = In->FloatChannel[2][i];
+
+        In->FloatChannel[0][i] = fClip((float) (1.0000 * comp0 - 0.0000 * comp1 + 1.4746 * comp2), 0.0, 1.0);
+        In->FloatChannel[1][i] = fClip((float) (1.0000 * comp0 - 0.1645 * comp1 - 0.5713 * comp2), 0.0, 1.0);
+        In->FloatChannel[2][i] = fClip((float) (1.0000 * comp0 + 1.8814 * comp1 - 0.0001 * comp2), 0.0, 1.0);
+    }
+}
+
+void TMHandleYUV(GenerateMetadataBuffer *metedataBuf, const YUVPicBuffer *Inputfile, sei_payload *sei_payloads,
+                 double targetedDisplay) {
+    // input frame format converting
+    YUV420to444(metedataBuf, Inputfile, &metedataBuf->FixedFile444P);
+    FixedtoFloat(&metedataBuf->FixedFile444P, &metedataBuf->FloatFile444P);
+    YUVtoRGB(&metedataBuf->FloatFile444P);
+    // general metadata
+    process(metedataBuf, metedataBuf->FloatFile444P.FloatChannel, metedataBuf->FloatFile444P.pic_width[0],
+            metedataBuf->FloatFile444P.pic_height[0], "", targetedDisplay);
+
+    // packet to SEI payload
+    PacketHDRVividmetedata(&metedataBuf->m_metadata, &metedataBuf->HDRVividBitStream1, &sei_payloads->payload,
+                           &sei_payloads->payloadSize);
+}
