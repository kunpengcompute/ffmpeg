+static double calc_basedcurve(HDRVividCurve curve, double threshold) {
+    double m_ptemp = (double) curve.m_p / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double m_mtemp = (double) curve.m_m / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double m_atemp = (double) curve.m_a / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double m_btemp = (double) curve.m_b / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double m_ntemp = (double) curve.m_n / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double K1temp = (double) curve.K1 / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double K2temp = (double) curve.K2 / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double K3temp = (double) curve.K3 / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+    double threshold1 = (double) threshold / ((double) (1 << HDRVIVID_METADATA_BASE_S));
+    double threshold1temp = pow(threshold1, m_ntemp);
+    double y1 = (m_ptemp * threshold1temp / ((K1temp * m_ptemp - K2temp) * threshold1temp + K3temp));
+    y1 = pow(y1, m_mtemp);
+    y1 = m_atemp * y1 + m_btemp;
+    return y1;
+}
