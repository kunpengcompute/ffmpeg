+static float CalPearson(GenerateMetadataBuffer *metedataBuf, float *RGB[3], int size) {
+    float sumx = 0.0;
+    float sumy = 0.0;
+    float sumxy = 0.0;
+    float sumx2 = 0.0;
+    float sumy2 = 0.0;
+
+    float *lastFrame = (float *) malloc(size * 3 * sizeof(float));
+    float *currentFrame = (float *) malloc(size * 3 * sizeof(float));
+
+    if (lastFrame == NULL || currentFrame == NULL) {
+        // 内存分配失败，返回错误值或处理错误
+        return 0.0;
+    }
+
+    for (int i = 0; i < size; i++) {
+        lastFrame[3 * i] = metedataBuf->last_floatComp[i];
+        lastFrame[3 * i + 1] = metedataBuf->last_floatComp[1 * metedataBuf->width * metedataBuf->height + i];
+        lastFrame[3 * i + 2] = metedataBuf->last_floatComp[2 * metedataBuf->width * metedataBuf->height + i];
+        currentFrame[3 * i] = RGB[0][i];
+        currentFrame[3 * i + 1] = RGB[1][i];
+        currentFrame[3 * i + 2] = RGB[2][i];
+    }
+
+    for (int j = 0; j < 3 * size; j++) {
+        sumx += lastFrame[j];
+        sumy += currentFrame[j];
+        sumxy += lastFrame[j] * currentFrame[j];
+        sumx2 += lastFrame[j] * lastFrame[j];
+        sumy2 += currentFrame[j] * currentFrame[j];
+    }
+
+    float molecular = sumxy - (((float) sumx * (float) sumy) / (3 * size));
+    float denominator = (float) (sqrt((sumx2 - (float) (sumx * sumx) / (3 * size) + 0.0000000001f) *
+                                      (sumy2 - (float) (sumy * sumy) / (3 * size) + 0.0000000001f))); // 避免除零
+
+    float result = 1.0;
+    if (!feq(denominator, 0)) {
+        result = molecular / denominator;
+    }
+
+    free(lastFrame);
+    free(currentFrame);
+
+    return result;
+}
