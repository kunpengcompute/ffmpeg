+            double threshold1 = (double) curve->TH1_HIGH / ((double) (1 << HDRVIVID_METADATA_BASE_S));
+            double threshold2 = (double) curve->TH2_HIGH / ((double) (1 << HDRVIVID_METADATA_BASE_S));
+            double threshold3 = (double) curve->TH3_HIGH / ((double) (1 << HDRVIVID_METADATA_BASE_S));
+            double MaxDisplaytemp = (double) MaxDisplay / ((double) (1 << HDRVIVID_METADATA_BASE_B));
+            double Referencedisplay = PQinverse(100.0 / 10000.0);
