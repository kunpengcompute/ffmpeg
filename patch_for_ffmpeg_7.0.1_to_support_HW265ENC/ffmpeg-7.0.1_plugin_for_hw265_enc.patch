+void GetYUVBuffer(YUVPicBuffer *pic, int width, int height, int dataType, int format) {
+    pic->pic_width[0] = width;
+    pic->pic_height[0] = height;
+    if (format == YUV444) {
+        pic->pic_width[1] = pic->pic_width[2] = pic->pic_width[0];
+        pic->pic_height[1] = pic->pic_height[2] = pic->pic_height[0];
+    } else {
+        pic->pic_width[1] = pic->pic_width[2] = pic->pic_width[0] / 2;
+        pic->pic_height[1] = pic->pic_height[2] = pic->pic_height[0] / 2;
+    }
+    for (int i = 0; i < 3; i++) {
+        pic->channel_num[i] = pic->pic_width[i] * pic->pic_height[i];
+    }
+    pic->totol_num = pic->channel_num[0] + pic->channel_num[1] + pic->channel_num[2];
+
+    if (dataType == Fixed) {
+        pic->FixedData = (uint8 *) malloc((unsigned int) pic->totol_num * sizeof(uint8));
+        pic->FixedChannel[0] = &pic->FixedData[0];
+        pic->FixedChannel[1] = pic->FixedChannel[0] + pic->channel_num[0];
+
+        pic->FixedChannel[2] = pic->FixedChannel[1] + pic->channel_num[1];
+        pic->FloatData = NULL;
+        pic->FloatChannel[0] = pic->FloatChannel[1] = pic->FloatChannel[2] = NULL;
+        memset(&pic->FixedData[0], 0, (int) pic->totol_num * sizeof(uint8));
+    } else {
+        pic->FloatData = (float *) malloc((unsigned int) pic->totol_num * sizeof(float));
+        pic->FloatChannel[0] = &pic->FloatData[0];
+        pic->FloatChannel[1] = pic->FloatChannel[0] + pic->channel_num[0];
+        pic->FloatChannel[2] = pic->FloatChannel[1] + pic->channel_num[1];
+        pic->FixedData = NULL;
+        pic->FixedChannel[0] = pic->FixedChannel[1] = pic->FixedChannel[2] = NULL;
+        memset(&pic->FloatData[0], 0, (int) pic->totol_num * sizeof(float));
+    }
+}
+
+void ReleaseYUVBuffer(YUVPicBuffer *pic) {
+    if (pic->FixedData != NULL) {
+        free(pic->FixedData);
+        pic->FixedData = NULL;
+    }
+    pic->FixedChannel[0] = NULL;
+    pic->FixedChannel[1] = NULL;
+    pic->FixedChannel[2] = NULL;
+
+    if (pic->FloatData != NULL) {
+        free(pic->FloatData);
+        pic->FloatData = NULL;
+    }
+    pic->FloatChannel[0] = NULL;
+    pic->FloatChannel[1] = NULL;
+    pic->FloatChannel[2] = NULL;
+}
+
