+                dstPtr += 48;
+
+            } while (--blocks);
+
+            return;
+        }
+
+        for (; pair + 8 <= pairs; pair += 8) {
+            const int lumOffset = pair * 2;
+            int16x8x2_t ys = vld2q_s16(lum0 + lumOffset);
+            int32x4_t y1Lo = vmull_lane_s16(vget_low_s16(ys.val[0]), lumFilterLane, 0);
+            int32x4_t y1Hi = vmull_high_lane_s16(ys.val[0], lumFilterLane, 0);
+            int32x4_t y2Lo = vmull_lane_s16(vget_low_s16(ys.val[1]), lumFilterLane, 0);
+            int32x4_t y2Hi = vmull_high_lane_s16(ys.val[1], lumFilterLane, 0);
+
+            ys = vld2q_s16(lum1 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 1);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 1);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 1);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 1);
+
+            ys = vld2q_s16(lum2 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 2);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 2);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 2);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 2);
+
+            ys = vld2q_s16(lum3 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 3);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 3);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 3);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 3);
+
+            int16x8_t us = vld1q_s16(chrU0 + pair);
+            int16x8_t vs = vld1q_s16(chrV0 + pair);
+            int32x4_t uLo = vmull_lane_s16(vget_low_s16(us), chrFilterLane, 0);
+            int32x4_t uHi = vmull_high_lane_s16(us, chrFilterLane, 0);
+            int32x4_t vLo = vmull_lane_s16(vget_low_s16(vs), chrFilterLane, 0);
+            int32x4_t vHi = vmull_high_lane_s16(vs, chrFilterLane, 0);
+
+            us = vld1q_s16(chrU1 + pair);
+            vs = vld1q_s16(chrV1 + pair);
+            uLo = vmlal_lane_s16(uLo, vget_low_s16(us), chrFilterLane, 1);
+            uHi = vmlal_high_lane_s16(uHi, us, chrFilterLane, 1);
+            vLo = vmlal_lane_s16(vLo, vget_low_s16(vs), chrFilterLane, 1);
+            vHi = vmlal_high_lane_s16(vHi, vs, chrFilterLane, 1);
+
+            y1Lo = vrshrq_n_s32(y1Lo, 19);
+            y1Hi = vrshrq_n_s32(y1Hi, 19);
+            y2Lo = vrshrq_n_s32(y2Lo, 19);
+            y2Hi = vrshrq_n_s32(y2Hi, 19);
+            uLo = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(uLo, 19));
+            uHi = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(uHi, 19));
+            vLo = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(vLo, 19));
+            vHi = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(vHi, 19));
+
+            /* Y * cy is shared by all three output channels. */
+            const int32x4_t y1BaseLo = vmulq_n_s32(y1Lo, cy);
+            const int32x4_t y1BaseHi = vmulq_n_s32(y1Hi, cy);
+            const int32x4_t y2BaseLo = vmulq_n_s32(y2Lo, cy);
+            const int32x4_t y2BaseHi = vmulq_n_s32(y2Hi, cy);
+
+            /* R: rBias + Y * cy + ((V * crv) >> 16) * cy. */
+            int32x4_t qLo = yuv2rgb24_lut_q_s32(vLo, crv);
+            int32x4_t qHi = yuv2rgb24_lut_q_s32(vHi, crv);
+            int32x4_t chromaLo = vmlaq_n_s32(vdupq_n_s32(rBias), qLo, cy);
+            int32x4_t chromaHi = vmlaq_n_s32(vdupq_n_s32(rBias), qHi, cy);
+            const uint8x8_t rEven =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+            const uint8x8_t rOdd =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+            /* G: gBias + Y * cy + (U contribution + V contribution) * cy. */
+            qLo = vaddq_s32(yuv2rgb24_lut_q_s32(uLo, cgu), yuv2rgb24_lut_q_s32(vLo, cgv));
+            qHi = vaddq_s32(yuv2rgb24_lut_q_s32(uHi, cgu), yuv2rgb24_lut_q_s32(vHi, cgv));
+            chromaLo = vmlaq_n_s32(vdupq_n_s32(gBias), qLo, cy);
+            chromaHi = vmlaq_n_s32(vdupq_n_s32(gBias), qHi, cy);
+            const uint8x8_t gEven =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+            const uint8x8_t gOdd =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+            /* B: bBias + Y * cy + ((U * cbu) >> 16) * cy. */
+            qLo = yuv2rgb24_lut_q_s32(uLo, cbu);
+            qHi = yuv2rgb24_lut_q_s32(uHi, cbu);
+            chromaLo = vmlaq_n_s32(vdupq_n_s32(bBias), qLo, cy);
+            chromaHi = vmlaq_n_s32(vdupq_n_s32(bBias), qHi, cy);
+            const uint8x8_t bEven =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+            const uint8x8_t bOdd =
+                yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+            uint8x16x3_t rgb;
+            rgb.val[0] = yuv2rgb24_interleave_pairs_u8(rEven, rOdd);
+            rgb.val[1] = yuv2rgb24_interleave_pairs_u8(gEven, gOdd);
+            rgb.val[2] = yuv2rgb24_interleave_pairs_u8(bEven, bOdd);
+
+            vst3q_u8(dest + pair * 6, rgb);
+        }
+    } else if (lumFilterSize == 4 && chrFilterSize == 2) {
+        const int16_t *lum0 = lumSrc[0];
+        const int16_t *lum1 = lumSrc[1];
+        const int16_t *lum2 = lumSrc[2];
+        const int16_t *lum3 = lumSrc[3];
+        const int16_t *chrU0 = chrUSrc[0];
+        const int16_t *chrU1 = chrUSrc[1];
+        const int16_t *chrV0 = chrVSrc[0];
+        const int16_t *chrV1 = chrVSrc[1];
+        /* Keep all fixed filter coefficients in two compact lane vectors. */
+        const int16x4_t lumFilterLane = vld1_s16(lumFilter);
+        const int16x4_t chrFilterLane = vset_lane_s16(chrFilter[1], vset_lane_s16(chrFilter[0], vdup_n_s16(0), 0), 1);
+
+        for (; pair + 8 <= pairs; pair += 8) {
+            const int lumOffset = pair * 2;
+            int32_t y1[8], y2[8], u[8], v[8];
+            int j;
+
+            int16x8x2_t ys = vld2q_s16(lum0 + lumOffset);
+            int32x4_t y1Lo = vmull_lane_s16(vget_low_s16(ys.val[0]), lumFilterLane, 0);
+            int32x4_t y1Hi = vmull_high_lane_s16(ys.val[0], lumFilterLane, 0);
+            int32x4_t y2Lo = vmull_lane_s16(vget_low_s16(ys.val[1]), lumFilterLane, 0);
+            int32x4_t y2Hi = vmull_high_lane_s16(ys.val[1], lumFilterLane, 0);
+
+            ys = vld2q_s16(lum1 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 1);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 1);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 1);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 1);
+
+            ys = vld2q_s16(lum2 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 2);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 2);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 2);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 2);
+
+            ys = vld2q_s16(lum3 + lumOffset);
+            y1Lo = vmlal_lane_s16(y1Lo, vget_low_s16(ys.val[0]), lumFilterLane, 3);
+            y1Hi = vmlal_high_lane_s16(y1Hi, ys.val[0], lumFilterLane, 3);
+            y2Lo = vmlal_lane_s16(y2Lo, vget_low_s16(ys.val[1]), lumFilterLane, 3);
+            y2Hi = vmlal_high_lane_s16(y2Hi, ys.val[1], lumFilterLane, 3);
+
+            int16x8_t us = vld1q_s16(chrU0 + pair);
+            int16x8_t vs = vld1q_s16(chrV0 + pair);
+            int32x4_t uLo = vmull_lane_s16(vget_low_s16(us), chrFilterLane, 0);
+            int32x4_t uHi = vmull_high_lane_s16(us, chrFilterLane, 0);
+            int32x4_t vLo = vmull_lane_s16(vget_low_s16(vs), chrFilterLane, 0);
+            int32x4_t vHi = vmull_high_lane_s16(vs, chrFilterLane, 0);
+
+            us = vld1q_s16(chrU1 + pair);
+            vs = vld1q_s16(chrV1 + pair);
+            uLo = vmlal_lane_s16(uLo, vget_low_s16(us), chrFilterLane, 1);
+            uHi = vmlal_high_lane_s16(uHi, us, chrFilterLane, 1);
+            vLo = vmlal_lane_s16(vLo, vget_low_s16(vs), chrFilterLane, 1);
+            vHi = vmlal_high_lane_s16(vHi, vs, chrFilterLane, 1);
+
+            vst1q_s32(y1, vrshrq_n_s32(y1Lo, 19));
+            vst1q_s32(y1 + 4, vrshrq_n_s32(y1Hi, 19));
+            vst1q_s32(y2, vrshrq_n_s32(y2Lo, 19));
+            vst1q_s32(y2 + 4, vrshrq_n_s32(y2Hi, 19));
+            vst1q_s32(u, vrshrq_n_s32(uLo, 19));
+            vst1q_s32(u + 4, vrshrq_n_s32(uHi, 19));
+            vst1q_s32(v, vrshrq_n_s32(vLo, 19));
+            vst1q_s32(v + 4, vrshrq_n_s32(vHi, 19));
+
+            for (j = 0; j < 8; j++) {
+                yuv2rgb24_write_pair(c, dest, pair + j, y1[j], y2[j], u[j], v[j]);
+            }
+        }
+    } else {
+        for (; pair + 8 <= pairs; pair += 8) {
+            int32x4_t y1Lo = vdupq_n_s32(1 << 18);
+            int32x4_t y1Hi = y1Lo;
+            int32x4_t y2Lo = y1Lo;
+            int32x4_t y2Hi = y1Lo;
+            int32x4_t uLo = y1Lo;
+            int32x4_t uHi = y1Lo;
+            int32x4_t vLo = y1Lo;
+            int32x4_t vHi = y1Lo;
+            int32_t y1[8], y2[8], u[8], v[8];
+            int j;
+
+            for (j = 0; j < lumFilterSize; j++) {
+                const int16x8_t filter = vdupq_n_s16(lumFilter[j]);
+                const int16x8x2_t ys = vld2q_s16(lumSrc[j] + pair * 2);
+
+                y1Lo = vmlal_s16(y1Lo, vget_low_s16(ys.val[0]), vget_low_s16(filter));
+                y1Hi = vmlal_high_s16(y1Hi, ys.val[0], filter);
+                y2Lo = vmlal_s16(y2Lo, vget_low_s16(ys.val[1]), vget_low_s16(filter));
+                y2Hi = vmlal_high_s16(y2Hi, ys.val[1], filter);
+            }
+
+            for (j = 0; j < chrFilterSize; j++) {
+                const int16x8_t filter = vdupq_n_s16(chrFilter[j]);
+                const int16x8_t us = vld1q_s16(chrUSrc[j] + pair);
+                const int16x8_t vs = vld1q_s16(chrVSrc[j] + pair);
+
+                uLo = vmlal_s16(uLo, vget_low_s16(us), vget_low_s16(filter));
+                uHi = vmlal_high_s16(uHi, us, filter);
+                vLo = vmlal_s16(vLo, vget_low_s16(vs), vget_low_s16(filter));
+                vHi = vmlal_high_s16(vHi, vs, filter);
+            }
+
+            vst1q_s32(y1, vshrq_n_s32(y1Lo, 19));
+            vst1q_s32(y1 + 4, vshrq_n_s32(y1Hi, 19));
+            vst1q_s32(y2, vshrq_n_s32(y2Lo, 19));
+            vst1q_s32(y2 + 4, vshrq_n_s32(y2Hi, 19));
+            vst1q_s32(u, vshrq_n_s32(uLo, 19));
+            vst1q_s32(u + 4, vshrq_n_s32(uHi, 19));
+            vst1q_s32(v, vshrq_n_s32(vLo, 19));
+            vst1q_s32(v + 4, vshrq_n_s32(vHi, 19));
+
+            for (j = 0; j < 8; j++) {
+                yuv2rgb24_write_pair(c, dest, pair + j, y1[j], y2[j], u[j], v[j]);
+            }
+        }
+    }
+
+    for (; pair < pairs; pair++) {
+        yuv2rgb24_X_scalar_pair(c, lumFilter, lumSrc, lumFilterSize, chrFilter, chrUSrc, chrVSrc, chrFilterSize, dest,
+                                pair);
+    }
+}
