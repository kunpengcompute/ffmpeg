+
+.Lhscale_3_1_tail:
+        cbz             w2, .Lhscale_3_1_done
+.Lhscale_3_1_tail_loop:
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             d16, [x9]
+        ldr             q17, [x4], #16
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
+        smull2          v19.4s, v16.8h, v17.8h
+        add             v18.4s, v18.4s, v19.4s
+        addv            s18, v18.4s
+        sqshrn          h18, s18, #7
+        st1             {v18.h}[0], [x1], #2
+        subs            w2, w2, #1
+        b.ne            .Lhscale_3_1_tail_loop
+.Lhscale_3_1_done:
+        ret
+endfunc
+
+
+        .p2align        3
+.Lhscale_5_2_tbl0:
+        .byte           0, 3, 5, 8, 10, 13, 15, 18
+.Lhscale_3_1_tbl0:
+        .byte           0, 3, 6, 9, 12, 15, 18, 21
