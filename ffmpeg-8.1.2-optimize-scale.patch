+/*
+ * Fixed 5:2 horizontal scaler for the two-phase, five-tap interior pattern.
+ * The dispatcher validates the complete filter/filterPos tables before using
+ * this kernel. Output 0 and the final seven outputs retain exact generic
+ * eight-tap evaluation; full interior groups use two-table TBL gathers.
+ */
+function ff_hscale8to15_5_2_neon, export=1
+        mov             x0, x3
+
+        // Output 0: exact generic 8-tap boundary calculation.
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             d16, [x9]
+        ldr             q17, [x4], #16
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
+        smull2          v19.4s, v16.8h, v17.8h
+        add             v18.4s, v18.4s, v19.4s
+        addv            s18, v18.4s
+        sqshrn          h18, s18, #7
+        st1             {v18.h}[0], [x1], #2
+        sub             w2, w2, #1
+
+        // Row 1/2 are the alternating phase A/B coefficient rows.
+        ldr             q20, [x4]
+        ldr             q21, [x4, #16]
+
+        dup             v22.8h, v20.h[0]
+        dup             v19.8h, v21.h[0]
+        trn1            v22.8h, v22.8h, v19.8h
+        dup             v23.8h, v20.h[1]
+        dup             v19.8h, v21.h[1]
+        trn1            v23.8h, v23.8h, v19.8h
+        dup             v24.8h, v20.h[2]
+        dup             v19.8h, v21.h[2]
+        trn1            v24.8h, v24.8h, v19.8h
+        dup             v25.8h, v20.h[3]
+        dup             v19.8h, v21.h[3]
+        trn1            v25.8h, v25.8h, v19.8h
+        dup             v26.8h, v20.h[4]
+        dup             v19.8h, v21.h[4]
+        trn1            v26.8h, v26.8h, v19.8h
+
+        // Output starts: 0,3,5,8,10,13,15,18. Taps 1..4 are +1..+4.
+        ldr             d27, .Lhscale_5_2_tbl0
+        movi            v28.8b, #1
+        add             v28.8b, v27.8b, v28.8b
+        movi            v29.8b, #2
+        add             v29.8b, v27.8b, v29.8b
+        movi            v30.8b, #3
+        add             v30.8b, v27.8b, v30.8b
+        movi            v31.8b, #4
+        add             v31.8b, v27.8b, v31.8b
+
+        cmp             w2, #15
+        b.lt            .Lhscale_5_2_tail
+        sub             w6, w2, #7
+        lsr             w6, w6, #3
+        cbz             w6, .Lhscale_5_2_tail
+
+        ldr             w9, [x5]
+        add             x3, x0, w9, uxtw
+        add             x4, x4, x6, lsl #7          // 8 rows * 8 coeffs * 2
+        add             x5, x5, x6, lsl #5          // 8 positions * 4
+        sub             w2, w2, w6, lsl #3
+
+        and             w8, w6, #1
+        lsr             w7, w6, #1
+        cbz             w7, 2f
+
+        .p2align        4
+1:
+        ldp             q0, q1, [x3]
+        add             x9, x3, #20
+        ldp             q6, q7, [x9]
+        add             x3, x3, #40
+
+        tbl             v2.8b, {v0.16b, v1.16b}, v27.8b
+        uxtl            v2.8h, v2.8b
+        smull           v4.4s, v2.4h, v22.4h
+        smull2          v5.4s, v2.8h, v22.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v28.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v23.4h
+        smlal2          v5.4s, v2.8h, v23.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v29.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v24.4h
+        smlal2          v5.4s, v2.8h, v24.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v30.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v25.4h
+        smlal2          v5.4s, v2.8h, v25.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v31.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v26.4h
+        smlal2          v5.4s, v2.8h, v26.8h
+
+        tbl             v16.8b, {v6.16b, v7.16b}, v27.8b
+        uxtl            v16.8h, v16.8b
+        smull           v17.4s, v16.4h, v22.4h
+        smull2          v18.4s, v16.8h, v22.8h
+        tbl             v16.8b, {v6.16b, v7.16b}, v28.8b
+        uxtl            v16.8h, v16.8b
+        smlal           v17.4s, v16.4h, v23.4h
+        smlal2          v18.4s, v16.8h, v23.8h
+        tbl             v16.8b, {v6.16b, v7.16b}, v29.8b
+        uxtl            v16.8h, v16.8b
+        smlal           v17.4s, v16.4h, v24.4h
+        smlal2          v18.4s, v16.8h, v24.8h
+        tbl             v16.8b, {v6.16b, v7.16b}, v30.8b
+        uxtl            v16.8h, v16.8b
+        smlal           v17.4s, v16.4h, v25.4h
+        smlal2          v18.4s, v16.8h, v25.8h
+        tbl             v16.8b, {v6.16b, v7.16b}, v31.8b
+        uxtl            v16.8h, v16.8b
+        smlal           v17.4s, v16.4h, v26.4h
+        smlal2          v18.4s, v16.8h, v26.8h
+
+        sqshrn          v4.4h, v4.4s, #7
+        sqshrn2         v4.8h, v5.4s, #7
+        sqshrn          v6.4h, v17.4s, #7
+        sqshrn2         v6.8h, v18.4s, #7
+        stp             q4, q6, [x1], #32
+        subs            w7, w7, #1
+        b.ne            1b
+
+2:
+        cbz             w8, .Lhscale_5_2_tail
+        ldp             q0, q1, [x3]
+        tbl             v2.8b, {v0.16b, v1.16b}, v27.8b
+        uxtl            v2.8h, v2.8b
+        smull           v4.4s, v2.4h, v22.4h
+        smull2          v5.4s, v2.8h, v22.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v28.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v23.4h
+        smlal2          v5.4s, v2.8h, v23.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v29.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v24.4h
+        smlal2          v5.4s, v2.8h, v24.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v30.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v25.4h
+        smlal2          v5.4s, v2.8h, v25.8h
+        tbl             v2.8b, {v0.16b, v1.16b}, v31.8b
+        uxtl            v2.8h, v2.8b
+        smlal           v4.4s, v2.4h, v26.4h
+        smlal2          v5.4s, v2.8h, v26.8h
+        sqshrn          v4.4h, v4.4s, #7
+        sqshrn2         v4.8h, v5.4s, #7
+        st1             {v4.8h}, [x1], #16
+
+.Lhscale_5_2_tail:
+        cbz             w2, .Lhscale_5_2_done
+.Lhscale_5_2_tail_loop:
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             d16, [x9]
+        ldr             q17, [x4], #16
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
+        smull2          v19.4s, v16.8h, v17.8h
+        add             v18.4s, v18.4s, v19.4s
+        addv            s18, v18.4s
+        sqshrn          h18, s18, #7
