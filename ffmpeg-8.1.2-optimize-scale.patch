+
+#include "config.h"
+#include <arm_neon.h>
+
+#include "libavutil/attributes.h"
+#include "libswscale/swscale.h"
+#include "libswscale/swscale_internal.h"
+#include "yuv2rgb24_neon.h"
+
+static av_always_inline void yuv2rgb24_write_pair(const SwsInternal *c, uint8_t *dest, int pair, int Y1, int Y2, int U,
+                                                  int V)
+{
+    const uint8_t *r = c->table_rV[V + YUVRGB_TABLE_HEADROOM];
+    const uint8_t *g = c->table_gU[U + YUVRGB_TABLE_HEADROOM] + c->table_gV[V + YUVRGB_TABLE_HEADROOM];
+    const uint8_t *b = c->table_bU[U + YUVRGB_TABLE_HEADROOM];
+    uint8_t *out = dest + pair * 6;
+
+    out[0] = r[Y1];
+    out[1] = g[Y1];
+    out[2] = b[Y1];
+    out[3] = r[Y2];
+    out[4] = g[Y2];
+    out[5] = b[Y2];
+}
+
+static av_always_inline void yuv2rgb24_X_scalar_pair(const SwsInternal *c, const int16_t *lumFilter,
+                                                     const int16_t **lumSrc, int lumFilterSize,
+                                                     const int16_t *chrFilter, const int16_t **chrUSrc,
+                                                     const int16_t **chrVSrc, int chrFilterSize, uint8_t *dest,
+                                                     int pair)
+{
+    int j;
+    int Y1 = 1 << 18;
+    int Y2 = 1 << 18;
+    int U = 1 << 18;
+    int V = 1 << 18;
+
+    for (j = 0; j < lumFilterSize; j++) {
+        Y1 += lumSrc[j][pair * 2] * (unsigned)lumFilter[j];
+        Y2 += lumSrc[j][pair * 2 + 1] * (unsigned)lumFilter[j];
+    }
+
+    for (j = 0; j < chrFilterSize; j++) {
+        U += chrUSrc[j][pair] * (unsigned)chrFilter[j];
+        V += chrVSrc[j][pair] * (unsigned)chrFilter[j];
+    }
+
+    yuv2rgb24_write_pair(c, dest, pair, Y1 >> 19, Y2 >> 19, U >> 19, V >> 19);
+}
+
+/*
+ * Clip four chroma samples exactly as av_clip_uint8(). The clipped values are
+ * shared by all R/G/B offset calculations in the current vector block.
+ */
+static av_always_inline int32x4_t yuv2rgb24_clip_u8_s32(int32x4_t chroma)
+{
+    const int32x4_t zero = vdupq_n_s32(0);
+    const int32x4_t max = vdupq_n_s32(255);
+
+    return vminq_s32(vmaxq_s32(chroma, zero), max);
+}
+
+/*
+ * Return the exact quotient used by FFmpeg 8.1.2 fill_table() for four
+ * already-clipped chroma samples:
+ *
+ *     q = (chroma * coeff) >> 16
+ *
+ * The constant -(coeff >> 9) part has been folded into the per-channel bias
+ * during table initialization.
+ */
+static av_always_inline int32x4_t yuv2rgb24_lut_q_s32(int32x4_t chroma, int coeff)
+{
+    return vshrq_n_s32(vmulq_n_s32(chroma, coeff), 16);
+}
+
+/* Convert two groups of four signed Q16 channel values to eight RGB bytes. */
+static av_always_inline uint8x8_t yuv2rgb24_lut_value_u8(int32x4_t valueLo, int32x4_t valueHi)
+{
+    const uint16x8_t value16 = vcombine_u16(vqshrun_n_s32(valueLo, 16), vqshrun_n_s32(valueHi, 16));
+
+    return vqmovn_u16(value16);
+}
+
+static av_always_inline uint8x16_t yuv2rgb24_interleave_pairs_u8(uint8x8_t even, uint8x8_t odd)
+{
+    const uint8x8x2_t zipped = vzip_u8(even, odd);
+
+    return vcombine_u8(zipped.val[0], zipped.val[1]);
+}
+
+/*
+ * Finish one 16-pixel bit-exact RGB24 block after vertical Y/U/V filtering.
+ * The arithmetic matches the optimized 4/2-tap path and FFmpeg's LUT
+ * construction; only the number of vertical taps differs between kernels.
+ */
+static av_always_inline void yuv2rgb24_store_filtered_16(const SwsInternal *c, uint8_t *dst, int32x4_t y1Lo,
+                                                         int32x4_t y1Hi, int32x4_t y2Lo, int32x4_t y2Hi, int32x4_t uLo,
+                                                         int32x4_t uHi, int32x4_t vLo, int32x4_t vHi)
+{
+    const int cy = c->yuv2rgb_lut32_cy;
+    const int crv = c->yuv2rgb_lut32_crv;
+    const int cbu = c->yuv2rgb_lut32_cbu;
+    const int cgu = c->yuv2rgb_lut32_cgu;
+    const int cgv = c->yuv2rgb_lut32_cgv;
+    const int rBias = c->yuv2rgb_lut32_r_bias;
+    const int gBias = c->yuv2rgb_lut32_g_bias;
+    const int bBias = c->yuv2rgb_lut32_b_bias;
+
+    y1Lo = vrshrq_n_s32(y1Lo, 19);
+    y1Hi = vrshrq_n_s32(y1Hi, 19);
+    y2Lo = vrshrq_n_s32(y2Lo, 19);
+    y2Hi = vrshrq_n_s32(y2Hi, 19);
+    uLo = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(uLo, 19));
+    uHi = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(uHi, 19));
+    vLo = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(vLo, 19));
+    vHi = yuv2rgb24_clip_u8_s32(vrshrq_n_s32(vHi, 19));
+
+    const int32x4_t y1BaseLo = vmulq_n_s32(y1Lo, cy);
+    const int32x4_t y1BaseHi = vmulq_n_s32(y1Hi, cy);
+    const int32x4_t y2BaseLo = vmulq_n_s32(y2Lo, cy);
+    const int32x4_t y2BaseHi = vmulq_n_s32(y2Hi, cy);
+
+    int32x4_t qLo = yuv2rgb24_lut_q_s32(vLo, crv);
+    int32x4_t qHi = yuv2rgb24_lut_q_s32(vHi, crv);
+    int32x4_t chromaLo = vmlaq_n_s32(vdupq_n_s32(rBias), qLo, cy);
+    int32x4_t chromaHi = vmlaq_n_s32(vdupq_n_s32(rBias), qHi, cy);
+    const uint8x8_t rEven =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+    const uint8x8_t rOdd =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+    qLo = vaddq_s32(yuv2rgb24_lut_q_s32(uLo, cgu), yuv2rgb24_lut_q_s32(vLo, cgv));
+    qHi = vaddq_s32(yuv2rgb24_lut_q_s32(uHi, cgu), yuv2rgb24_lut_q_s32(vHi, cgv));
+    chromaLo = vmlaq_n_s32(vdupq_n_s32(gBias), qLo, cy);
+    chromaHi = vmlaq_n_s32(vdupq_n_s32(gBias), qHi, cy);
+    const uint8x8_t gEven =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+    const uint8x8_t gOdd =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+    qLo = yuv2rgb24_lut_q_s32(uLo, cbu);
+    qHi = yuv2rgb24_lut_q_s32(uHi, cbu);
+    chromaLo = vmlaq_n_s32(vdupq_n_s32(bBias), qLo, cy);
+    chromaHi = vmlaq_n_s32(vdupq_n_s32(bBias), qHi, cy);
+    const uint8x8_t bEven =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y1BaseLo, chromaLo), vaddq_s32(y1BaseHi, chromaHi));
+    const uint8x8_t bOdd =
+        yuv2rgb24_lut_value_u8(vaddq_s32(y2BaseLo, chromaLo), vaddq_s32(y2BaseHi, chromaHi));
+
+    uint8x16x3_t rgb;
+    rgb.val[0] = yuv2rgb24_interleave_pairs_u8(rEven, rOdd);
+    rgb.val[1] = yuv2rgb24_interleave_pairs_u8(gEven, gOdd);
+    rgb.val[2] = yuv2rgb24_interleave_pairs_u8(bEven, bOdd);
+    vst3q_u8(dst, rgb);
+}
+
+/**
+ * NEON implementation of the normal YUV-to-RGB24 vertical scaler.
+ *
+ * The 4-tap luma / 2-tap chroma bit-exact path reproduces the RGB24 LUT
+ * construction performed by ff_yuv2rgb_c_init_tables() in FFmpeg 8.1.2,
+ * but evaluates it with 32-bit NEON arithmetic and writes 16 RGB24 pixels
+ * with vst3q_u8(). All unsupported or unsafe configurations retain the
+ * original LUT path.
+ */
+void ff_yuv2rgb24_X_neon(SwsInternal *c, const int16_t *lumFilter, const int16_t **lumSrc, int lumFilterSize,
+                         const int16_t *chrFilter, const int16_t **chrUSrc, const int16_t **chrVSrc, int chrFilterSize,
+                         const int16_t **alpSrc, uint8_t *dest, int dstW, int y)
+{
+    const int pairs = (dstW + 1) >> 1;
+    int pair = 0;
+
+    (void)alpSrc;
+    (void)y;
+
+    /*
+     * Fixed scenario 2: 1920x1280 YUV420P -> 768x512 RGB24.
+     * FFmpeg bilinear tables are 6-tap luma and 4-tap chroma vertically.
+     */
+    if (lumFilterSize == 6 && chrFilterSize == 4 && dstW == 768 && c->opts.src_format == AV_PIX_FMT_YUV420P &&
