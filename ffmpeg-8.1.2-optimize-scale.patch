diff --git a/libswscale/swscale_internal.h b/libswscale/swscale_internal.h
index 7d5eeae..aef42a8 100644
--- a/libswscale/swscale_internal.h
+++ b/libswscale/swscale_internal.h
@@ -701,0 +702,16 @@ struct SwsInternal {
+
+    /*
+     * Exact parameters used to construct the 8-bit RGB24 YUV lookup table.
+     * The AArch64 path uses these only when all intermediate operations are
+     * proven to fit signed 32-bit arithmetic; otherwise it keeps using the
+     * original byte-addressed LUT.
+     */
+    int yuv2rgb_lut32_neon_ok;
+    int yuv2rgb_lut32_cy;
+    int yuv2rgb_lut32_crv;
+    int yuv2rgb_lut32_cbu;
+    int yuv2rgb_lut32_cgu;
+    int yuv2rgb_lut32_cgv;
+    int yuv2rgb_lut32_r_bias;
+    int yuv2rgb_lut32_g_bias;
+    int yuv2rgb_lut32_b_bias;
diff --git a/libswscale/yuv2rgb.c b/libswscale/yuv2rgb.c
index c622018..3c131c1 100644
--- a/libswscale/yuv2rgb.c
+++ b/libswscale/yuv2rgb.c
@@ -706,0 +707,163 @@ static uint16_t roundToInt16(int64_t f)
+static int yuv2rgb_fits_int32(int64_t value)
+{
+    return value >= INT32_MIN && value <= INT32_MAX;
+}
+
+static int yuv2rgb_mul_u8_fits_int32(int64_t value)
+{
+    return value >= INT32_MIN / 255 && value <= INT32_MAX / 255;
+}
+
+/*
+ * Return the exact minimum and maximum quotient generated by:
+ *
+ *     (av_clip_uint8(chroma) * inc) >> 16
+ *
+ * The expression is monotonic in chroma, so the endpoints cover [0, 255].
+ */
+static int yuv2rgb_lut_q_range(int64_t inc, int64_t *minimum, int64_t *maximum)
+{
+    int64_t q0;
+    int64_t q255;
+
+    if (!yuv2rgb_fits_int32(inc) || !yuv2rgb_mul_u8_fits_int32(inc)) {
+        return 0;
+    }
+
+    q0 = 0;
+    q255 = (inc * 255) >> 16;
+
+    if (!yuv2rgb_fits_int32(q255)) {
+        return 0;
+    }
+
+    *minimum = FFMIN(q0, q255);
+    *maximum = FFMAX(q0, q255);
+    return 1;
+}
+
+/*
+ * Verify the reordered channel expression used by the AArch64 fast path:
+ *
+ *     value = bias + Y * cy + q * cy
+ *
+ * The RGB lookup tables reserve 512 luma entries below zero and 512 above
+ * 255, so the valid luma index range is [-512, 767]. Every intermediate is
+ * checked in the same order used by the NEON implementation.
+ */
+static int yuv2rgb_lut32_channel_safe(int64_t cy, int64_t bias, int64_t qmin, int64_t qmax)
+{
+    const int64_t ymin = -YUVRGB_TABLE_LUMA_HEADROOM;
+    const int64_t ymax = 255 + YUVRGB_TABLE_LUMA_HEADROOM;
+    const int64_t yprod0 = ymin * cy;
+    const int64_t yprod1 = ymax * cy;
+    const int64_t qprod0 = qmin * cy;
+    const int64_t qprod1 = qmax * cy;
+    const int64_t yprod_min = FFMIN(yprod0, yprod1);
+    const int64_t yprod_max = FFMAX(yprod0, yprod1);
+    const int64_t qprod_min = FFMIN(qprod0, qprod1);
+    const int64_t qprod_max = FFMAX(qprod0, qprod1);
+    const int64_t partial_min = bias + yprod_min;
+    const int64_t partial_max = bias + yprod_max;
+
+    return yuv2rgb_fits_int32(bias) && yuv2rgb_fits_int32(yprod_min) && yuv2rgb_fits_int32(yprod_max) &&
+           yuv2rgb_fits_int32(qprod_min) && yuv2rgb_fits_int32(qprod_max) && yuv2rgb_fits_int32(partial_min) &&
+           yuv2rgb_fits_int32(partial_max) && yuv2rgb_fits_int32(partial_min + qprod_min) &&
+           yuv2rgb_fits_int32(partial_max + qprod_max);
+}
+
+/*
+ * The direct AArch64 implementation uses signed 32-bit multiply/add. Enable
+ * it only when both the original LUT construction and the reordered
+ * precomputed-bias expression are representable without overflow.
+ */
+static int yuv2rgb_lut32_params_safe(int64_t cy, int64_t crv, int64_t cbu, int64_t cgu, int64_t cgv, int yoffs,
+                                     int64_t ybias, int table_plane_size, int32_t *r_bias, int32_t *g_bias,
+                                     int32_t *b_bias)
+{
+    int64_t rqmin, rqmax, bqmin, bqmax;
+    int64_t guqmin, guqmax, gvqmin, gvqmax;
+    int64_t gqmin, gqmax;
+    int64_t roff_min, roff_max;
+    int64_t boff_min, boff_max;
+    int64_t goff_min, goff_max;
+    int64_t rbias64, gbias64, bbias64;
+    int64_t last_product;
+
+    if (!yuv2rgb_fits_int32(cy) || !yuv2rgb_fits_int32(ybias) || cy < INT32_MIN / (table_plane_size - 1) ||
+        cy > INT32_MAX / (table_plane_size - 1)) {
+        return 0;
+    }
+
+    last_product = cy * (table_plane_size - 1);
+    if (!yuv2rgb_fits_int32(last_product) || !yuv2rgb_fits_int32(ybias + last_product)) {
+        return 0;
+    }
+
+    if (!yuv2rgb_lut_q_range(crv, &rqmin, &rqmax) || !yuv2rgb_lut_q_range(cbu, &bqmin, &bqmax) ||
+        !yuv2rgb_lut_q_range(cgu, &guqmin, &guqmax) || !yuv2rgb_lut_q_range(cgv, &gvqmin, &gvqmax)) {
+        return 0;
+    }
+
+    gqmin = guqmin + gvqmin;
+    gqmax = guqmax + gvqmax;
+    if (!yuv2rgb_fits_int32(gqmin) || !yuv2rgb_fits_int32(gqmax)) {
+        return 0;
+    }
+
+    roff_min = -(crv >> 9) + rqmin;
+    roff_max = -(crv >> 9) + rqmax;
