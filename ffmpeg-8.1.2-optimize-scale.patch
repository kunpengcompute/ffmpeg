+            } else if (hscale8to15_3_1_neon_compatible(c->opts.src_w, c->opts.dst_w, c->lumXInc,
+                                                       c->hLumFilterSize, c->hLumFilter,
+                                                       c->hLumFilterPos)) {
+                c->hyScale = ff_hscale8to15_3_1_neon;
+            }
+
+            if (hscale8to15_3_2_neon_compatible(c->chrSrcW, c->chrDstW, c->chrXInc,
+                                                c->hChrFilterSize, c->hChrFilter,
+                                                c->hChrFilterPos)) {
+                c->hcScale = ff_hscale8to15_3_2_neon;
+            } else if (hscale8to15_5_2_neon_compatible(c->chrSrcW, c->chrDstW, c->chrXInc,
+                                                       c->hChrFilterSize, c->hChrFilter,
+                                                       c->hChrFilterPos)) {
+                c->hcScale = ff_hscale8to15_5_2_neon;
+            } else if (hscale8to15_3_1_neon_compatible(c->chrSrcW, c->chrDstW, c->chrXInc,
+                                                       c->hChrFilterSize, c->hChrFilter,
+                                                       c->hChrFilterPos)) {
+                c->hcScale = ff_hscale8to15_3_1_neon;
+            }
+        }
+
+        if (c->opts.src_format == AV_PIX_FMT_YUV420P &&
+            dstFormat == AV_PIX_FMT_RGB24 &&
+            !(c->opts.flags & SWS_FULL_CHR_H_INT)) {
+            c->yuv2packedX = ff_yuv2rgb24_X_neon;
+        }
diff --git a/libswscale/aarch64/yuv2rgb24_neon.c b/libswscale/aarch64/yuv2rgb24_neon.c
new file mode 100644
index 0000000..048439e
--- /dev/null
+++ b/libswscale/aarch64/yuv2rgb24_neon.c
@@ -0,0 +1,742 @@
