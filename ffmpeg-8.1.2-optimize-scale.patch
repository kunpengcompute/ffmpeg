+/*
+ * Fixed 3:2 horizontal scaler for the two-phase, three-tap interior pattern.
+ *
+ * The C dispatcher selects this kernel only after verifying that:
+ *   - srcW:dstW is exactly 3:2 and xInc is 98304;
+ *   - filterSize is 4;
+ *   - outputs 1 .. dstW-2 alternate between two fixed coefficient rows;
+ *   - the fourth coefficient of both interior phases is zero;
+ *   - filterPos follows base, base+1, base+3, base+4, ...
+ *
+ * Output 0 and the final seven outputs are evaluated from filter/filterPos with
+ * the generic scalar four-tap calculation.  Full interior groups use one
+ * contiguous 16-byte source load for eight outputs and three TBL operations.
+ */
+function ff_hscale8to15_3_2_neon, export=1
+// x0  SwsInternal *c (not used; reused as the unmodified source base)
+// x1  int16_t *dst
+// w2  int dstW
+// x3  const uint8_t *src
+// x4  const int16_t *filter
+// x5  const int32_t *filterPos
+// w6  int filterSize (verified as 4 by the dispatcher)
+//
+// The vector loop is unrolled by two.  Each main iteration computes two
+// consecutive 8-output groups (16 outputs total) using two overlapping
+// contiguous 16-byte loads.  An optional final 8-output group uses the same
+// fixed 3:2 TBL path.  Scalar processing remains for the exact boundaries.
+
+        mov             x0, x3                      // preserve source base for scalar boundaries
+
+        // Output 0: retain the exact generic four-tap boundary calculation.
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             s16, [x9]
+        ldr             d17, [x4], #8
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
+        addv            s18, v18.4s
+        sqshrn          h18, s18, #7
+        st1             {v18.h}[0], [x1], #2
+        sub             w2, w2, #1
+
+        // Build three alternating coefficient vectors from phase A/B rows.
+        // x4 now points at filter row 1 (phase A), x4+8 at row 2 (phase B).
+        ldr             d20, [x4]
+        ldr             d21, [x4, #8]
+
+        dup             v22.8h, v20.h[0]
+        dup             v28.8h, v21.h[0]
+        trn1            v22.8h, v22.8h, v28.8h      // tap 0: A0,B0,A0,B0,...
+
+        dup             v23.8h, v20.h[1]
+        dup             v28.8h, v21.h[1]
+        trn1            v23.8h, v23.8h, v28.8h      // tap 1: A1,B1,A1,B1,...
+
+        dup             v24.8h, v20.h[2]
+        dup             v28.8h, v21.h[2]
+        trn1            v24.8h, v24.8h, v28.8h      // tap 2: A2,B2,A2,B2,...
+
+        // Base TBL indices are {0,1,3,4,6,7,9,10}; the other taps are +1/+2.
+        ldr             d25, .Lhscale_3_2_tbl0
+        movi            v26.8b, #1
+        add             v26.8b, v25.8b, v26.8b
+        movi            v27.8b, #2
+        add             v27.8b, v25.8b, v27.8b
+
+        // Leave at least seven outputs for exact scalar processing: six
+        // interior outputs plus the right boundary.  Count complete 8-output
+        // groups, then execute pairs of groups in the 16-output main loop.
+        cmp             w2, #15
+        b.lt            .Lhscale_3_2_tail
+        sub             w6, w2, #7
+        lsr             w6, w6, #3                  // total number of 8-output groups
+        cbz             w6, .Lhscale_3_2_tail
+
+        ldr             w9, [x5]                    // filterPos[1], start of phase A
+        add             x3, x0, w9, uxtw
+
+        // Advance filter tables directly to the scalar tail.  The fixed
+        // vector kernel no longer reads per-output filter/filterPos entries.
+        add             x4, x4, x6, lsl #6          // 8 rows * 4 coeffs * 2 bytes
+        add             x5, x5, x6, lsl #5          // 8 positions * 4 bytes
+        sub             w2, w2, w6, lsl #3
+
+        and             w8, w6, #1                  // optional final 8-output group
+        lsr             w7, w6, #1                  // number of 16-output groups
+        cbz             w7, 2f
+
+        .p2align        4
+1:
+        // Two adjacent 8-output groups consume 24 new source bytes.  The two
+        // 16-byte loads overlap by four bytes, avoiding LD3 deinterleaving and
+        // retaining the TBL data layout that performed better on this CPU.
+        ldr             q0, [x3]
+        ldr             q6, [x3, #12]
+        add             x3, x3, #24
+
+        // First 8 outputs.
+        tbl             v1.8b, {v0.16b}, v25.8b
+        tbl             v2.8b, {v0.16b}, v26.8b
+        tbl             v3.8b, {v0.16b}, v27.8b
+
+        uxtl            v1.8h, v1.8b
+        uxtl            v2.8h, v2.8b
+        uxtl            v3.8h, v3.8b
+
+        smull           v4.4s, v1.4h, v22.4h
+        smull2          v5.4s, v1.8h, v22.8h
+        smlal           v4.4s, v2.4h, v23.4h
+        smlal2          v5.4s, v2.8h, v23.8h
+        smlal           v4.4s, v3.4h, v24.4h
+        smlal2          v5.4s, v3.8h, v24.8h
+
+        // Second 8 outputs.  Eight outputs preserve the A/B phase, so the
+        // same TBL indices and coefficient vectors are reused unchanged.
+        tbl             v16.8b, {v6.16b}, v25.8b
+        tbl             v17.8b, {v6.16b}, v26.8b
+        tbl             v18.8b, {v6.16b}, v27.8b
+
+        uxtl            v16.8h, v16.8b
+        uxtl            v17.8h, v17.8b
+        uxtl            v18.8h, v18.8b
+
+        smull           v19.4s, v16.4h, v22.4h
+        smull2          v20.4s, v16.8h, v22.8h
+        smlal           v19.4s, v17.4h, v23.4h
+        smlal2          v20.4s, v17.8h, v23.8h
+        smlal           v19.4s, v18.4h, v24.4h
+        smlal2          v20.4s, v18.8h, v24.8h
+
+        sqshrn          v4.4h, v4.4s, #7
+        sqshrn2         v4.8h, v5.4s, #7
+        sqshrn          v6.4h, v19.4s, #7
+        sqshrn2         v6.8h, v20.4s, #7
+        stp             q4, q6, [x1], #32
+
+        subs            w7, w7, #1
+        b.ne            1b
+
+        // When the number of vector groups is odd, retain one final original
+        // 8-output TBL block rather than moving those outputs to scalar code.
+2:
+        cbz             w8, .Lhscale_3_2_tail
+
+        ldr             q0, [x3]
+        tbl             v1.8b, {v0.16b}, v25.8b
+        tbl             v2.8b, {v0.16b}, v26.8b
+        tbl             v3.8b, {v0.16b}, v27.8b
+
+        uxtl            v1.8h, v1.8b
+        uxtl            v2.8h, v2.8b
+        uxtl            v3.8h, v3.8b
+
+        smull           v4.4s, v1.4h, v22.4h
+        smull2          v5.4s, v1.8h, v22.8h
+        smlal           v4.4s, v2.4h, v23.4h
+        smlal2          v5.4s, v2.8h, v23.8h
+        smlal           v4.4s, v3.4h, v24.4h
+        smlal2          v5.4s, v3.8h, v24.8h
+
+        sqshrn          v4.4h, v4.4s, #7
+        sqshrn2         v4.8h, v5.4s, #7
+        st1             {v4.8h}, [x1], #16
+
+        // Exact generic calculation for the remaining interior samples and
+        // the right boundary.  This also avoids any source over-read at row end.
+.Lhscale_3_2_tail:
+        cbz             w2, .Lhscale_3_2_done
+.Lhscale_3_2_tail_loop:
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             s16, [x9]
+        ldr             d17, [x4], #8
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
+        addv            s18, v18.4s
+        sqshrn          h18, s18, #7
+        st1             {v18.h}[0], [x1], #2
+        subs            w2, w2, #1
+        b.ne            .Lhscale_3_2_tail_loop
+.Lhscale_3_2_done:
+        ret
+endfunc
+
+
