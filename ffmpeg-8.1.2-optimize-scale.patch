+/*
+ * Fixed 3:1 horizontal scaler for the one-phase, five-tap interior pattern.
+ * The same safety and exact-boundary policy as the 5:2 kernel is used.
+ */
+function ff_hscale8to15_3_1_neon, export=1
+        mov             x0, x3
+
+        ldr             w8, [x5], #4
+        add             x9, x0, w8, uxtw
+        ldr             d16, [x9]
+        ldr             q17, [x4], #16
+        uxtl            v16.8h, v16.8b
+        smull           v18.4s, v16.4h, v17.4h
