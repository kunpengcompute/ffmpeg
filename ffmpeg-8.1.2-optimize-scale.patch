diff --git a/libswscale/aarch64/swscale.c b/libswscale/aarch64/swscale.c
index 4f86364..e8a03fa 100644
--- a/libswscale/aarch64/swscale.c
+++ b/libswscale/aarch64/swscale.c
@@ -24,0 +25 @@
+#include "yuv2rgb24_neon.h"
@@ -189,0 +191,138 @@ ALL_SCALE_FUNCS(neon);
+SCALE_FUNC(3_2, 8, 15, neon);
+SCALE_FUNC(5_2, 8, 15, neon);
+SCALE_FUNC(3_1, 8, 15, neon);
+
+/*
+ * Match only the exact two-phase 3:2 layout consumed by
+ * ff_hscale8to15_3_2_neon(). The first and final outputs are deliberately
+ * excluded from the phase check because the assembly evaluates them from
+ * filter/filterPos with the generic four-tap calculation.
+ */
+static int hscale8to15_3_2_neon_compatible(int srcW, int dstW, int xInc, int filterSize,
+                                           const int16_t *filter, const int32_t *filterPos)
+{
+    if (!filter || !filterPos || filterSize != 4 || dstW < 10) {
+        return 0;
+    }
+    if ((int64_t)srcW * 2 != (int64_t)dstW * 3 || xInc != 98304) {
+        return 0;
+    }
+    if ((dstW - 2) & 1) {
+        return 0;
+    }
+
+    const int16_t *phaseA = filter + filterSize;
+    const int16_t *phaseB = phaseA + filterSize;
+    if (phaseA[3] != 0 || phaseB[3] != 0) {
+        return 0;
+    }
+
+    const int basePos = filterPos[1];
+    if (basePos < 0) {
+        return 0;
+    }
+
+    for (int i = 1; i < dstW - 1; i++) {
+        const int phase = (i - 1) & 1;
+        const int expectedPos = basePos + 3 * ((i - 1) >> 1) + phase;
+        const int16_t *expected = phase ? phaseB : phaseA;
+        const int16_t *current = filter + i * filterSize;
+
+        if (filterPos[i] != expectedPos) {
+            return 0;
+        }
+        for (int j = 0; j < filterSize; j++) {
+            if (current[j] != expected[j]) {
+                return 0;
+            }
+        }
+    }
+
+    return 1;
+}
+
+/* Match the exact two-phase 5:2, five-effective-tap layout. */
+static int hscale8to15_5_2_neon_compatible(int srcW, int dstW, int xInc, int filterSize,
+                                           const int16_t *filter, const int32_t *filterPos)
+{
+    if (!filter || !filterPos || filterSize != 8 || dstW < 12) {
+        return 0;
+    }
+    if ((int64_t)srcW * 2 != (int64_t)dstW * 5 || xInc != 163840) {
+        return 0;
+    }
+
+    const int16_t *phaseA = filter + filterSize;
+    const int16_t *phaseB = phaseA + filterSize;
+    for (int j = 5; j < filterSize; j++) {
+        if (phaseA[j] || phaseB[j]) {
+            return 0;
+        }
+    }
+
+    const int basePos = filterPos[1];
+    if (basePos < 0) {
+        return 0;
+    }
+
+    /* The final two outputs are border-adjusted and stay on the exact tail. */
+    for (int i = 1; i < dstW - 2; i++) {
+        const int phase = (i - 1) & 1;
+        const int expectedPos = basePos + 5 * ((i - 1) >> 1) + 3 * phase;
+        const int16_t *expected = phase ? phaseB : phaseA;
+        const int16_t *current = filter + i * filterSize;
+
+        if (filterPos[i] != expectedPos) {
+            return 0;
+        }
+        for (int j = 0; j < filterSize; j++) {
+            if (current[j] != expected[j]) {
+                return 0;
+            }
+        }
+    }
+
+    return 1;
+}
+
+/* Match the exact one-phase 3:1, five-effective-tap layout. */
+static int hscale8to15_3_1_neon_compatible(int srcW, int dstW, int xInc, int filterSize,
+                                           const int16_t *filter, const int32_t *filterPos)
+{
+    if (!filter || !filterPos || filterSize != 8 || dstW < 12) {
+        return 0;
+    }
+    if ((int64_t)srcW != (int64_t)dstW * 3 || xInc != 196608) {
+        return 0;
+    }
+
+    const int16_t *phase = filter + filterSize;
+    for (int j = 5; j < filterSize; j++) {
+        if (phase[j]) {
+            return 0;
+        }
+    }
+
+    const int basePos = filterPos[1];
+    if (basePos < 0) {
+        return 0;
+    }
+
+    /* The final two outputs are border-adjusted and stay on the exact tail. */
+    for (int i = 1; i < dstW - 2; i++) {
+        const int expectedPos = basePos + 3 * (i - 1);
+        const int16_t *current = filter + i * filterSize;
+
+        if (filterPos[i] != expectedPos) {
+            return 0;
+        }
+        for (int j = 0; j < filterSize; j++) {
+            if (current[j] != phase[j]) {
+                return 0;
+            }
+        }
+    }
+
+    return 1;
+}
+
@@ -359,0 +499,41 @@ av_cold void ff_sws_init_swscale_aarch64(SwsInternal *c)
